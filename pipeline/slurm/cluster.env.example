# Copy to pipeline/slurm/cluster.env (gitignored) and fill in your cluster's values.
# submit_fork_checks.sh reads it before anything else; write each entry as
# VAR=${VAR:-value} so a value given on the command line still takes precedence.
ACCOUNT=${ACCOUNT:-<slurm account>}
PARTITION=${PARTITION:-<gpu partition>}
QOS=${QOS:-}                       # leave empty for the account's default QOS
GPU_TYPE=${GPU_TYPE:-}             # gres type of the GPUs the baselines trained on
CPUS_PER_GPU=${CPUS_PER_GPU:-10}
MEM_PER_GPU=${MEM_PER_GPU:-48G}
MAIL_USER=${MAIL_USER:-}           # set to receive Slurm job emails
