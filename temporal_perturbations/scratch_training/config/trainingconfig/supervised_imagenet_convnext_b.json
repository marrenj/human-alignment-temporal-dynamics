{
    "name": "supervised_imagenet_convnext_b",
    "task": "supervised",
    "model": {
        "name": "convnext_b",
        "num_classes": 1000,
        "image_size": 224,
        "pretrained": false,
        "drop_path_rate": 0.5
    },
    "data": {
        "dataset_type": "imagenet1k",
        "data_dir": null,
        "image_size": 224,
        "batch_size": 256,
        "num_workers": 8,
        "pin_memory": true,
        "interpolation": "bicubic",
        "val_dataset_root": null,
        "eval_batch_size": 256,
        "randaugment_config": "rand-m9-mstd0.5-inc1",
        "mixup_alpha": 0.8,
        "cutmix_alpha": 1.0,
        "mixup_prob": 1.0,
        "mixup_switch_prob": 0.5,
        "mixup_mode": "batch"
    },
    "optimizer": {"name": "adamw", "lr": 0.004, "weight_decay": 0.05, "beta1": 0.9, "beta2": 0.999, "eps": 1e-8},
    "scheduler": {"name": "cosine", "warmup_steps": 10000, "min_lr": 1e-6},
    "loss": {"name": "cross_entropy", "label_smoothing": 0.1},
    "distributed": {"strategy": "ddp", "sync_batchnorm": true, "find_unused_parameters": false, "num_nodes": 1},
    "epochs": 90,
    "precision": "bf16-mixed",
    "seed": 42,
    "gradient_clip_val": 1.0,
    "accumulate_grad_batches": null,
    "target_batch_size": 1536,
    "log_every_n_steps": 50,
    "save_dir": null,
    "save_top_k": 5,
    "deterministic": true,
    "validate_every_n_epoch": 1,
    "monitor_metric": "val/imagenet/acc1",
    "monitor_mode": "max"
}
